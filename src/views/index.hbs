<div class="container-fluid mt-4">
    <div class="row">
        <!-- horario del día -->
        <div class="col-lg-4 mb-4">
            <div class="oscuro2 rounded p-3">
                <h4 class="text-center">Tu horario de hoy</h4>
                <ul class="list-unstyled mb-0" id="horario"></ul>
            </div>
        </div>

        <!-- imágenes -->
        <div class="col-lg-8">
            <div class="row">
                {{#each images}}
                <div class="col-sm-6 col-md-4 mb-4">
                    <a href="/images/{{uniqueId}}" class="text-white">
                        <div class="card oscuro2 h-100">
                            <img src="/public/upload/{{filename}}" class="card-img-top gallery-img" alt="{{title}}">
                            <div class="card-body p-2">
                                <h6 class="card-title mb-1">{{title}}</h6>
                                <small><i class="fas fa-heart"></i> {{likes}} &nbsp; <i class="fas fa-eye"></i> {{views}}</small>
                            </div>
                        </div>
                    </a>
                </div>
                {{else}}
                <div class="col-12 text-center p-5">
                    <p>Todavía no hay imágenes. Usa el botón <b>+</b> para compartir la primera.</p>
                </div>
                {{/each}}
            </div>
        </div>
    </div>
</div>

<!--subir foto-->
<div class="overlay" id="subeimg">
    <div class="oscuro contain text-white p-3">
        <div class="d-flex justify-content-between">
            <h4>Subir imagen</h4>
            <button type="button" class="close text-white" data-close="#subeimg">&times;</button>
        </div>
        <form action="/images" method="POST" enctype="multipart/form-data">
            <div class="form-group">
                <div class="custom-file">
                    <input type="file" name="image" class="custom-file-input" id="inputGroupFile" accept="image/*" required />
                    <label class="custom-file-label" for="inputGroupFile">Elige un archivo</label>
                </div>
            </div>
            <div class="form-group">
                <input type="text" name="title" class="form-control" placeholder="Título de la imagen" required>
            </div>
            <div class="form-group">
                <textarea name="description" rows="2" class="form-control" placeholder="Descripción de la imagen" required></textarea>
            </div>
            <button class="btn btn-success">
                <i class="fa fa-upload"></i> Subir imagen
            </button>
        </form>
    </div>
</div>

<!-- ajuste-->
<div class="overlay oscuro text-white text-center" id="ajuste">
    <form class="pt-5" id="ajusteForm">
        <h1 style="font-size: 5em;">DayLife</h1>
        <label for="hora">¿A qué hora te gustaría despertar?</label>
        <div class="form-group d-flex justify-content-center mb-4">
            <input type="time" name="hora" id="hora" class="form-control w-auto" required>
        </div>
        <p>Si indicas tu hora de iniciar el día <br> se generará un horario perfecto para la productividad de tu día.</p>
        <button type="submit" class="btn btn-success col-6 col-md-2">Guardar</button>
    </form>
</div>
