<div class="container mt-4 mb-5">
  <div class="card oscuro2">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h2 class="mb-0">{{ image.title }}</h2>
      {{#if isOwner}}
      <button class="btn btn-danger" id="btn-delete" data-id="{{image.uniqueId}}">
        <i class="fa fa-times"></i> Borrar
      </button>
      {{/if}}
    </div>
    <div class="card-body">
      <p>{{ image.description }}</p>
      <div class="text-center">
        <img src="/public/upload/{{image.filename}}" class="img-fluid" alt="{{image.title}}">
      </div>
    </div>
    <div class="card-footer d-flex justify-content-between align-items-center">
      <button class="btn btn-success" id="btn-like" data-id="{{image.uniqueId}}">
        <i class="fas fa-thumbs-up"></i> Me gusta
      </button>
      <p class="mb-0"><span class="likes-count">{{image.likes}}</span> <i class="fas fa-heart"></i></p>
      <p class="mb-0"><i class="fas fa-eye"></i> {{image.views}}</p>
      <p class="mb-0"><i class="far fa-clock"></i> {{timeago image.timestamp}}</p>
    </div>
  </div>

  <div class="card oscuro2 mt-4">
    <div class="card-header"><h4 class="mb-0">Comentarios</h4></div>
    <div class="card-body">
      <form action="/images/{{image.uniqueId}}/comment" method="POST" class="mb-4">
        <div class="form-group">
          <textarea name="comment" rows="2" class="form-control" placeholder="Escribe un comentario" required></textarea>
        </div>
        <button class="btn btn-success"><i class="fas fa-comment"></i> Comentar</button>
      </form>
      {{#each comments}}
      <div class="media mb-3" id="{{_id}}">
        <img src="https://www.gravatar.com/avatar/{{this.gravatar}}?d=identicon" class="mr-3 rounded-circle" width="45" alt="">
        <div class="media-body">
          <b>{{name}}</b> <small class="text-muted">{{timeago timestamp}}</small>
          <p class="mb-0">{{comment}}</p>
        </div>
      </div>
      {{else}}
      <p class="mb-0">Sé el primero en comentar.</p>
      {{/each}}
    </div>
  </div>
</div>
